Token TokenCualquiera() : { Token t; }
{
  (
      t=<TIPO_ENT> | t=<TIPO_DEC> | t=<TIPO_CAD> | t=<TIPO_CAR> | t=<TIPO_BOO> | t=<TIPO_VACIO> | t=<CONST>

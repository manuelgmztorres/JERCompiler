void Sentencia() : {}
{
  try {
    (
        LOOKAHEAD(TipoDato()) DeclaracionVariable() <FIN_INSTRUCCION>
      | LOOKAHEAD(<CONST>) DeclaracionConstante() <FIN_INSTRUCCION>
      | LOOKAHEAD(<SI>) EstructuraSi()
      | LOOKAHEAD(<MIENTRAS>) EstructuraMientras()
      | LOOKAHEAD(<REPETIR>) EstructuraRepetir()
      | LOOKAHEAD(<EVALUAR>) EstructuraEvaluar()
      | LOOKAHEAD(<HACER>) EstructuraHacer()
      | LOOKAHEAD(<IMP>) SentenciaImprimir()
      | LOOKAHEAD(<OBT>) SentenciaObtener()
      | LOOKAHEAD(<TERMINAR>) SentenciaTerminar()
      | LOOKAHEAD(<RET>) SentenciaRetorno()
      | LOOKAHEAD(<IDENTIFICADOR>) AsignacionOLlamada()
      | SentenciaInvalida()
    )
  } catch (ParseException e) {
    reportarError(e);
    recuperarSentencia();
  }
}


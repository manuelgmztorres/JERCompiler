Token TokenCualquiera() : { Token t; }
{
  (
      t=<TIPO_ENT> | t=<TIPO_DEC> | t=<TIPO_CAD> | t=<TIPO_CAR> | t=<TIPO_BOO> | t=<TIPO_VACIO> | t=<CONST>
    | t=<SI> | t=<SINO> | t=<MIENTRAS> | t=<REPETIR> | t=<HACER> | t=<EVALUAR> | t=<CUANDO> | t=<PRED>
    | t=<TERMINAR> | t=<FUN> | t=<RET> | t=<OBT> | t=<IMP> | t=<VERDADERO> | t=<FALSO>
    | t=<NUMERO_DECIMAL> | t=<NUMERO_ENTERO> | t=<CADENA> | t=<CARACTER>
    | t=<STRING_NO_CERRADA> | t=<CARACTER_INVALIDO> | t=<ERROR_LEXICO>
    | t=<ASIG_INC> | t=<ASIG_DEC> | t=<ASIGNACION> | t=<POTENCIA> | t=<RAIZ> | t=<INC> | t=<DEC_OP>
    | t=<MAYOR_IGUAL> | t=<MENOR_IGUAL> | t=<DIFERENTE> | t=<SUMA> | t=<RESTA> | t=<MULT> | t=<DIV> | t=<MODULO>
    | t=<IGUAL> | t=<MAYOR_QUE> | t=<MENOR_QUE> | t=<AND> | t=<OR> | t=<NOT>
    | t=<APERTURA_PAREN> | t=<CIERRE_PAREN> | t=<APERTURA_BLOQUE> | t=<CIERRE_BLOQUE>
    | t=<APERTURA_CORCHETE> | t=<CIERRE_CORCHETE> | t=<FIN_INSTRUCCION> | t=<SEPARADOR> | t=<DOS_PUNTOS>
    | t=<IDENTIFICADOR>

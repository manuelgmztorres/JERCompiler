void DeclaracionGlobal() : {}
{
  try {
    ( LOOKAHEAD(<CONST>) DeclaracionConstante() | DeclaracionVariable() ) <FIN_INSTRUCCION>
  } catch (ParseException e) {
    reportarError(e);
    recuperarGlobal();
